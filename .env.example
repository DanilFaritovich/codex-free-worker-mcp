# Select exactly one execution backend. Existing installations default to OpenCode.
FREE_WORKER_BACKEND=opencode

# OpenCode backend.
# OPENROUTER_API_KEY is only needed when the configured OpenCode provider expects it.
OPENROUTER_API_KEY=
FREE_WORKER_OPENCODE_BIN=opencode
FREE_WORKER_OPENCODE_MODEL=provider/model

# Codex backend.
FREE_WORKER_CODEX_BIN=codex
FREE_WORKER_CODEX_MODEL=gpt-6-luna
FREE_WORKER_CODEX_REASONING_EFFORT=low
# Codex-only sandbox choices; both default to workspace-write.
# Use read-only to forbid filesystem writes; validation caches may then fail.
FREE_WORKER_INSPECT_SANDBOX=workspace-write
FREE_WORKER_FIX_SANDBOX=workspace-write

# Shared worker limits.
FREE_WORKER_ALLOWED_ROOTS=/home/YOU/Work
FREE_WORKER_TIMEOUT_SECONDS=840
FREE_WORKER_MAX_RESULT_CHARS=8000

# Structured application logging. MCP protocol messages use stdout; logs use stderr.
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=codex-free-worker
ENVIRONMENT=development
