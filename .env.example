# Optional: only needed when your OpenCode provider expects this variable.
OPENROUTER_API_KEY=

# Replace with the provider/model you want OpenCode to use.
FREE_WORKER_MODEL=provider/model

FREE_WORKER_OPENCODE_BIN=opencode
FREE_WORKER_ALLOWED_ROOTS=/home/YOU/Work
FREE_WORKER_TIMEOUT_SECONDS=840
FREE_WORKER_MAX_RESULT_CHARS=8000
